# 将本机秘密写到已忽略的 .env.local；不要提交真实密钥。
GEMINI_API_KEY=替换为实际模型密钥
HARNESS_AUTH_TOKENS={"本地开发调用方":"替换为随机长凭据"}
HARNESS_LC_URL=http://127.0.0.1:8000
# 可选：固定所用知识版本；省略时从服务健康信息取得并在本次运行固定。
# HARNESS_LC_SNAPSHOT=lc/v1.11.0
HARNESS_WORK_DIR=work
# 开发脚本默认开启诊断能力；生产直接启动时默认关闭，可显式设置 true 临时开启。
# 实际读取须同时具有下列维护者资格及该任务的访问权。
HARNESS_DEBUG_IDENTITIES=["本地开发调用方"]
# HARNESS_DIAGNOSTICS=false
# 云端追踪独立配置；开发脚本未配置时关闭。生产直接启动请显式设为 false；
# 原生服务可能仅因存在 API Key 自动开启，且旧版 tracing 别名也需清除或同步。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=替换为实际追踪密钥
# LANGSMITH_PROJECT=k12-harness-dev
