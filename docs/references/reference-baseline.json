      "out_of_tree_activities": {
        "sql": "WITH RECURSIVE tree(id) AS (SELECT identifier FROM node_Course UNION SELECT p.targetIdentifier FROM rel_hasPart p JOIN tree t ON p.sourceIdentifier=t.id) SELECT count(*) AS total,sum(CASE WHEN EXISTS(SELECT 1 FROM rel_hasReference r WHERE (r.sourceIdentifier=a.identifier AND r.targetIdentifier IN (SELECT id FROM tree)) OR (r.targetIdentifier=a.identifier AND r.sourceIdentifier IN (SELECT id FROM tree))) THEN 1 ELSE 0 END) AS referenced_from_or_to_tree FROM node_Activity a WHERE a.identifier NOT IN (SELECT id FROM tree)",
        "rows": [
