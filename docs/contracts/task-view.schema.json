        "capability": {
          "const": "curriculum_design",
          "default": "curriculum_design",
          "title": "Capability",
          "type": "string"
        },
        "grade": {
          "const": 8,
          "default": 8,
          "title": "Grade",
          "type": "integer"
        },
        "scope": {
          "const": "section",
          "default": "section",
          "title": "Scope",
          "type": "string"
        },
        "instruction": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "target_codes": {
          "items": {
            "pattern": "^8\\.(?:F|EE)\\.[A-C]\\.[1-9]$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Target Codes",
          "type": "array"
        },
        "school": {
          "$ref": "#/$defs/School"
        },
        "external_content": {
          "items": {
            "$ref": "#/$defs/ExternalContent"
