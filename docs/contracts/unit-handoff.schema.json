    "Block": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "markdown",
            "table",
            "image"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "headers": {
          "items": {
            "type": "string"
          },
          "title": "Headers",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "src": {
          "default": "",
          "title": "Src",
          "type": "string"
        },
        "alt": {
          "default": "",
          "title": "Alt",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Block",
      "type": "object"
    },
    "CheckRecord": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/ReviewEvidence"
        },
        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "rules_fingerprint": {
          "title": "Rules Fingerprint",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "findings",
        "evidence",
        "fingerprint",
        "rules_fingerprint",
        "method",
        "applicable",
        "passed"
      ],
      "title": "CheckRecord",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "enum": [
            "coverage",
            "mathematics",
            "progression",
            "conditions",
            "evidence",
            "sources"
          ],
          "title": "Criterion",
          "type": "string"
        },
        "target": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "detail": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "criterion",
        "target",
        "detail",
        "blocking"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GoalAllocation": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z0-9_-]{1,60}$",
          "title": "Unit Id",
          "type": "string"
