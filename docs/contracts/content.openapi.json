            ]
          },
          "rendered": {
            "type": "boolean",
            "title": "Rendered",
            "default": false
          },
          "render_errors": {
            "items": {
              "$ref": "#/components/schemas/RenderIssue"
            },
            "type": "array",
            "title": "Render Errors"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
