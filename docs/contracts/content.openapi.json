      "TaskRequest": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "event_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Event Id"
          },
          "capability": {
            "type": "string",
            "const": "curriculum_design",
            "title": "Capability",
            "default": "curriculum_design"
          },
          "grade": {
            "type": "integer",
            "const": 8,
            "title": "Grade",
            "default": 8
          },
          "scope": {
            "type": "string",
            "const": "section",
            "title": "Scope",
            "default": "section"
          },
          "instruction": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Instruction"
          },
          "target_codes": {
            "items": {
              "type": "string",
              "pattern": "^8\\.(?:F|EE)\\.[A-C]\\.[1-9]$"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Target Codes"
          },
          "school": {
            "$ref": "#/components/schemas/School"
          },
          "external_content": {
            "items": {
              "$ref": "#/components/schemas/ExternalContent"
            },
            "type": "array",
            "maxItems": 5,
            "title": "External Content"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "language": {
            "type": "string",
            "const": "zh-CN",
            "title": "Language",
            "default": "zh-CN"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "instruction",
          "target_codes",
          "school",
          "limits"
        ],
        "title": "TaskRequest"
      },
      "TaskView": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "incomplete",
              "stopped",
              "cancelled",
