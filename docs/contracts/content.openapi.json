          "fingerprint": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fingerprint"
          },
          "assets": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Assets"
          },
          "checks": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckRecord"
